PAPER_ID=example
DOCKER_HUB_USER=your_docker_hub_user
# Root of your spyglass data directory. No trailing slash.
# The export folder is expected at ${SPYGLASS_BASE_DIR}/export/${PAPER_ID}/.
SPYGLASS_BASE_DIR=/your/base/dir
# Conda environment used for build-time Python helpers (port hashing, SQL patching).
SPYGLASS_CONDA_ENV=spyglass
# Set to 1 if your system requires `sudo docker` (common on shared Linux servers).
SUDO_DOCKER=0
# Default password for Jupyter is the paper ID
JUPYTER_SERVER_APP_PASSWORD=${PAPER_ID}

# Optional — required only for embargoed DANDI datasets
# DANDI_API_KEY=your_key_here

# --- Leave these as is ---
# MYSQL config
MYSQL_USER=root
MYSQL_HOST=db
MYSQL_ROOT_PASSWORD=tutorial
MYSQL_ROOT_HOST=%
# DataJoint config
DJ_SUPPORT_FILEPATH_MANAGEMENT=TRUE
HD5_USE_FILE_LOCKING=FALSE
# Path mapping — derived automatically by the Makefile from SPYGLASS_BASE_DIR
# and PAPER_ID. Override here only if your export folder uses a different layout.
# SPYGLASS_PAPER_DIR=/custom/path/to/export
# SPYGLASS_VOLUME_DIR=/custom/path/to/volumes
# Image name
HUB_IMAGE_NAME=${DOCKER_HUB_USER}/spyglass-hub-${PAPER_ID}
DB_IMAGE_NAME=${DOCKER_HUB_USER}/spyglass-db-${PAPER_ID}
